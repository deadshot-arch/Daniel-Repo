import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.PreparedStatement;
import java.sql.SQLException;

public class DatabaseInsertExample {

    // Database credentials and URL configuration
    private static final String DB_URL = "jdbc:mysql://localhost:3306/your_database_name";
    private static final String DB_USER = "root";
    private static final String DB_PASSWORD = "your_password";

    public static void main(String[] args) {
        // SQL query template with parameterized placeholders (?) to prevent SQL injection
        String insertSql = "INSERT INTO users (username, email, age) VALUES (?, ?, ?)";

        // Try-with-resources automatically closes Connection and PreparedStatement objects
        try (Connection connection = DriverManager.getConnection(DB_URL, DB_USER, DB_PASSWORD);
             PreparedStatement preparedStatement = connection.prepareStatement(insertSql)) {
            
            System.out.println("Connected to the database successfully!");

            // Bind values to the first parameterized placeholder (?)
            preparedStatement.setString(1, "john_doe");
            // Bind values to the second parameterized placeholder (?)
            preparedStatement.setString(2, "john.doe@example.com");
            // Bind values to the third parameterized placeholder (?)
            preparedStatement.setInt(3, 28);

            // Execute the insert operation
            int rowsAffected = preparedStatement.executeUpdate();
            
            System.out.println("Data inserted successfully! Rows affected: " + rowsAffected);

        } catch (SQLException e) {
            System.err.println("Database connection or execution failed!");
            e.printStackTrace();
        }
    }
}
